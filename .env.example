# Haruki-Cloud environment configuration
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real secrets.

# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL — container superuser (used only by the postgres container itself)
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_superuser

# Shared connection settings (used to compose DSNs below)
PG_HOST=postgres
PG_PORT=5432
PG_SSLMODE=disable

# ─────────────────────────────────────────────────────────────────────────────
# Per-database credentials
# Each DB gets its own name, user, and password.
# The init script creates the users and databases on first container start.
# ─────────────────────────────────────────────────────────────────────────────

# PJSK
PJSK_DB_NAME=haruki_pjsk
PJSK_DB_USER=haruki_pjsk
PJSK_DB_PASSWORD=changeme

# Sekai
SEKAI_DB_NAME=haruki_sekai
SEKAI_DB_USER=haruki_sekai
SEKAI_DB_PASSWORD=changeme

# Chunithm (music and binding share the same database and user by default)
CHUNITHM_DB_NAME=haruki_chunithm
CHUNITHM_DB_USER=haruki_chunithm
CHUNITHM_DB_PASSWORD=changeme

# Users (profile bindings)
USERS_DB_NAME=haruki_users
USERS_DB_USER=haruki_users
USERS_DB_PASSWORD=changeme

# Bot (auth / sessions)
BOT_DB_NAME=haruki_bot
BOT_DB_USER=haruki_bot
BOT_DB_PASSWORD=changeme

# Censor (text/image moderation results)
CENSOR_DB_NAME=haruki_censor
CENSOR_DB_USER=haruki_censor
CENSOR_DB_PASSWORD=changeme

# Image cache metadata
IMAGECACHE_DB_NAME=haruki_imagecache
IMAGECACHE_DB_USER=haruki_imagecache
IMAGECACHE_DB_PASSWORD=changeme

# ─────────────────────────────────────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# Backend server
# ─────────────────────────────────────────────────────────────────────────────
HARUKI_NODE_NAME=
HARUKI_NODE_ROLE=
# Set true on standby/recovering nodes to reject user/business DB writes.
HARUKI_NODE_READ_ONLY=false

HARUKI_BACKEND_HOST=0.0.0.0
HARUKI_BACKEND_PORT=6666
HARUKI_BACKEND_LOG_LEVEL=INFO
HARUKI_BACKEND_SSL=false
HARUKI_BACKEND_SSL_CERT=
HARUKI_BACKEND_SSL_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Module toggles
# ─────────────────────────────────────────────────────────────────────────────
HARUKI_PJSK_ENABLED=true
HARUKI_SEKAI_ENABLED=true
HARUKI_SEKAI_AUTO_MIGRATE=false
HARUKI_CHUNITHM_ENABLED=false

# ─────────────────────────────────────────────────────────────────────────────
# Bot secrets  ⚠️  Use strong random values in production
# ─────────────────────────────────────────────────────────────────────────────
HARUKI_BOT_TURNSTILE_SECRET=
HARUKI_BOT_SMTP_HOST=smtp.example.com
HARUKI_BOT_SMTP_PORT=587
HARUKI_BOT_SMTP_USERNAME=noreply@example.com
HARUKI_BOT_SMTP_PASSWORD=
HARUKI_BOT_SMTP_FROM=Haruki Bot <noreply@example.com>
HARUKI_BOT_CREDENTIAL_SIGN_TOKEN=
HARUKI_BOT_SESSION_SIGN_TOKEN=
HARUKI_BOT_INTERNAL_API_TOKEN=
HARUKI_BOT_SESSION_TTL_DAYS=7
# Hex-encoded 32-byte X25519 private key for Noise IK transport encryption.
# Leave empty to disable Noise encryption (plaintext JSON fallback).
HARUKI_BOT_NOISE_PRIVATE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# External APIs
# ─────────────────────────────────────────────────────────────────────────────
HARUKI_SEKAI_API_BASE_URL=https://api.sekai.haruki.example.com
HARUKI_SEKAI_API_TOKEN=

HARUKI_TOOLBOX_BASE_URL=
HARUKI_TOOLBOX_API_TOKEN=

HARUKI_TRACKER_BASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Content censor
# ─────────────────────────────────────────────────────────────────────────────
# Text censor — Baidu AI Content Censor
HARUKI_CENSOR_BAIDU_API_KEY=
HARUKI_CENSOR_BAIDU_SECRET=

# Image censor — Tencent Cloud Image Moderation Service (IMS)
HARUKI_CENSOR_TENCENT_SECRET_ID=
HARUKI_CENSOR_TENCENT_SECRET_KEY=
HARUKI_CENSOR_TENCENT_REGION=ap-guangzhou
HARUKI_CENSOR_TENCENT_BIZ_TYPE=

# ─────────────────────────────────────────────────────────────────────────────
# PJSK render runtime (optional; set HARUKI_PJSK_RENDER_ENABLED=true to activate)
# ─────────────────────────────────────────────────────────────────────────────
HARUKI_PJSK_RENDER_ENABLED=false
HARUKI_PJSK_RENDER_DRAWING_BASE_URL=http://localhost:3001
HARUKI_PJSK_RENDER_IMAGE_CACHE_CHARTS_URI=https://public-beta-image-cache-sha01-direct.example.haruki.local:40011/charts
HARUKI_PJSK_RENDER_MUSIC_META_OUTPUT_DIR=
HARUKI_PJSK_RENDER_SK_FORECAST_LOCAL_BASE_URL=http://100.109.13.111:18746
HARUKI_PJSK_RENDER_3D_PREVIEW_ENABLED=false
HARUKI_PJSK_RENDER_3D_PREVIEW_ENGINE_BASE_URL=http://haruki-3d-engine:8080
HARUKI_PJSK_RENDER_3D_PREVIEW_STATIC_RELATIVE_DIR=static_images/pjsk_3d_preview
HARUKI_PJSK_RENDER_3D_PREVIEW_STATIC_OUTPUT_DIR=
HARUKI_PJSK_RENDER_3D_PREVIEW_WIDTH=1400
HARUKI_PJSK_RENDER_3D_PREVIEW_HEIGHT=1000
HARUKI_PJSK_RENDER_3D_PREVIEW_SCALE=2
HARUKI_PJSK_RENDER_3D_PREVIEW_TIMEOUT=45s
HARUKI_PJSK_RENDER_3D_PREVIEW_REGISTRY_CACHE_TTL=5m
